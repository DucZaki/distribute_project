# Sao chép thành .env và điền giá trị thật (file .env không được commit).

JWT_SECRET=bookingtour-super-secret-key-change-in-prod-min-256-bits-required-aaaa

# Google OAuth2 — redirect URI trong Google Console:
#   http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth2
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# URL frontend nhận token sau OAuth (Vite: http://localhost:5173/oauth/callback)
OAUTH_FRONTEND_REDIRECT=http://localhost:8088/oauth/callback

# Amadeus test API
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# VNPay sandbox
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_RETURN_URL=http://localhost:8080/api/vnpay/return
VNP_FRONTEND_RETURN_URL=http://localhost:8088/payment/result
VNP_IPN_URL=http://localhost:8080/api/vnpay/ipn
VNP_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# NewsAPI
NEWS_API_KEY=

# Chatbot (Groq → OpenRouter → Gemini)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
GEMINI_API_KEY=

# OpenAI (tùy chọn, integration-service)
OPENAI_API_KEY=

# SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@bookingtour.com
MAIL_ENABLED=true

# QR check-in / link tuyệt đối
APP_BASE_URL=http://localhost:8080
CHECKIN_BASE_URL=http://localhost:8080/api/check-in
